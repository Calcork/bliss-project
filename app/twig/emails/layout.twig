<!DOCTYPE html>
<html><head><meta charset="UTF-8"></head>
<body style="font-family: sans-serif; background-color: #f3f4f6; padding: 40px 0;">
<div style="max-width: 480px; margin: 0 auto; background-color: #ffffff; border: 1px solid #e5e7eb; border-radius: 8px; padding: 32px;">
    <h1 style="font-size: 20px; font-weight: 700; color: #1f2937; margin: 0 0 24px 0;">{% block heading %}{% endblock %}</h1>
    {% block content %}{% endblock %}
    <div style="margin-top: 32px; padding-top: 16px; border-top: 1px solid #e5e7eb; font-size: 12px; color: #9ca3af;">Bliss</div>
</div>
</body>
</html>

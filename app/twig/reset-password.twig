{% extends 'layout.twig' %}

{% set app_url = app.getEnv()['APP_URL'] %}
{% set routes = app.getRoutes().all() %}
{% set inputs = app.getConfig()['inputs'] %}

{% block title %}{{ trans('main.reset_password.title') }}{% endblock %}


{% block body %}
<div class="login-page">

    <div class="login-card">
        {{ react_island('ResetPasswordForm', {
            action: app_url ~ routes['r|reset-password|POST'].toUri(),
            token: token,
            errors: errors,
            t: {
                title: trans('main.reset_password.title'),
                password: trans('main.reset_password.password'),
                submit: trans('main.reset_password.submit')
            },
            constraints: {
                password: {
                    minlength: inputs['password'].min_length,
                    maxlength: inputs['password'].max_length
                }
            },
            login_url: app_url ~ routes['r|login|GET'].toUri(),
            t_back_to_login: trans('main.forgot_password.back_to_login')
        }) }}
    </div>

</div>
{% endblock %}

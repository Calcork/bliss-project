{% extends 'layout.twig' %}

{% set app_url = app.getEnv()['APP_URL'] %}
{% set routes = app.getRoutes().all() %}

{% block title %}{{ trans('main.home.title') }}{% endblock %}

{% block body %}
<div class="home-page">

    {% if is_logged_in %}
        {% set nav_links = [
            { url: app_url ~ routes['r|dashboard|GET'].toUri(), label: trans('main.dashboard.title') },
            { url: app_url ~ routes['r|logout|GET'].toUri(), label: trans('main.home.logout') }
        ] %}
    {% else %}
        {% set nav_links = [
            { url: app_url ~ routes['r|register|GET'].toUri(), label: trans('main.home.register') },
            { url: app_url ~ routes['r|login|GET'].toUri(), label: trans('main.home.login') }
        ] %}
    {% endif %}
    {% include '_nav.twig' %}

    <div class="home-hero">
        <h1 class="home-hero__title">{{ trans('main.home.hero_title') }}</h1>
        <p class="home-hero__subtitle">{{ trans('main.home.hero_subtitle') }}</p>
        <div class="home-hero__actions">
            <a href="{{ app_url ~ routes['r|login|GET'].toUri() }}" class="home-hero__button">{{ trans('main.home.get_started') }}</a>
        </div>
    </div>

    <div class="home-features">
        <div class="home-feature">
            <h2 class="home-feature__title">{{ trans('main.home.feature_routing_title') }}</h2>
            <p class="home-feature__text">{{ trans('main.home.feature_routing_text') }}</p>
        </div>
        <div class="home-feature">
            <h2 class="home-feature__title">{{ trans('main.home.feature_cli_title') }}</h2>
            <p class="home-feature__text">{{ trans('main.home.feature_cli_text') }}</p>
        </div>
        <div class="home-feature">
            <h2 class="home-feature__title">{{ trans('main.home.feature_orm_title') }}</h2>
            <p class="home-feature__text">{{ trans('main.home.feature_orm_text') }}</p>
        </div>
    </div>

    <div class="home-footer">
        <p class="home-footer__text">{{ trans('main.home.footer') }}</p>
    </div>

</div>
{% endblock %}

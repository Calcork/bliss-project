{% extends 'layout.twig' %}

{% set app_url = app.getEnv()['APP_URL'] %}
{% set routes = app.getRoutes().all() %}
{% set inputs = app.getConfig()['inputs'] %}

{% block title %}{{ trans('main.forgot_password.title') }}{% endblock %}


{% block body %}
<div class="login-page">

    <div class="login-card">
        {{ react_island('ForgotPasswordForm', {
            action: app_url ~ routes['r|forgot-password|POST'].toUri(),
            errors: errors,
            old_email: old_email,
            t: {
                title: trans('main.forgot_password.title'),
                email: trans('main.forgot_password.email'),
                submit: trans('main.forgot_password.submit')
            },
            constraints: {
                email: {
                    pattern: inputs['email'].regex,
                    maxlength: inputs['email'].max_length
                }
            },
            login_url: app_url ~ routes['r|login|GET'].toUri(),
            t_back_to_login: trans('main.forgot_password.back_to_login')
        }) }}
    </div>

</div>
{% endblock %}

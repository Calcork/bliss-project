{
    "name": "hizech/bliss",
    "type": "project",
    "autoload": {
        "psr-4": {
            "Hizech\\Bliss\\": "src/",
            "App\\Controllers\\": "app/controllers/",
            "App\\Models\\": "app/models/",
            "App\\Base\\": "app/base/",
            "App\\Generated\\": "app/generated/",
            "App\\Tests\\": "app/tests/",
            "App\\Lib\\": "app/lib/",
            "App\\Database\\Migrations\\": "app/database/migrations/",
            "App\\AppCode\\": "app/appcode"
        },
      "files": [
        "head.php"
      ]
    },
    "authors": [
        {
            "name": "Yoel Trujio Vargas",
            "email": "contact@hizech.com"
        }
    ],
    "require": {
        "symfony/http-foundation": "^7.3",
        "twig/twig": "^3.21",
        "symfony/yaml": "^7.3",
        "ext-fileinfo": "*",
        "ext-pdo": "*",
        "ext-curl": "*",
        "ext-pdo_sqlite": "*",
        "symfony/process": "^7.3",
        "ueberdosis/tiptap-php": "^2.0",
        "symfony/rate-limiter": "^8.0",
        "ext-zip": "*",
        "ext-apcu": "*",
        "doctrine/orm": "^3.6",
        "symfony/cache": "^8.0",
        "symfony/var-exporter": "^7.0",
        "symfony/config": "^8.0",
        "doctrine/migrations": "^3.9"
    },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.1"
  },
  "config": {
    "platform": {
      "php": "8.5.0"
    }
  }
}
